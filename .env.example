# Supabase — get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-side only (set in the Vercel project env, NOT exposed to the browser) ---

# Supabase credentials used by the /api functions to verify the caller's JWT.
# These can mirror the VITE_ values above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Required for the /api/admin endpoint (suspend/delete users).
# Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Vercel deploy hook fired when an admin publishes a blog post so
# the prerendered site regenerates. Vercel -> Project Settings -> Git -> Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=

# Puter.js hosting — FREE, UNLIMITED static site hosting via browser SDK.
# No server-side token needed! The Puter.js SDK (loaded via <script src="https://js.puter.com/v2/"></script>)
# handles authentication automatically via browser popup when the user deploys.
# Users sign in to Puter directly from the browser — zero server config required.
# Hosted sites get *.puter.site subdomains.

# E2B Sandbox credentials — cloud sandboxes for code execution & filesystem.
# Get your API key at https://e2b.dev — free tier available.
# Used by /api/e2b-sandbox for runtime command execution and filesystem operations.
E2B_API_KEY=your-e2b-api-key-here
# Optional: E2B sandbox template (default: 'base')
# E2B_TEMPLATE=base
# Optional: Maximum execution timeout in ms (default: 300000 = 5 minutes)
# E2B_TIMEOUT_MS=300000

# Optional: Firebase Admin credentials for push notifications when E2B tasks complete.
# Only needed if you want background sandbox completion alerts.
# Create a service account key at https://console.firebase.google.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_KEY={"type":"service_account",...}

# Secret used to encrypt stored provider API keys at rest (AES-256-GCM).
# Generate a long random value, e.g. `openssl rand -base64 48`.
# If unset, the app falls back to weaker client-side key encryption.
KEY_ENCRYPTION_SECRET=your-long-random-secret-here

# Optional: Supabase OAuth app for "Authorize Supabase" backend connections
# (BYO-Supabase full-stack app generation). Register an OAuth app in your
# Supabase org settings; set the redirect URL to
# <app>/api/supabase-oauth?action=callback. Connection storage reuses
# SUPABASE_SERVICE_ROLE_KEY and KEY_ENCRYPTION_SECRET above. If unset, the
# "Add a backend" panel is disabled (the app still generates static sites).
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
